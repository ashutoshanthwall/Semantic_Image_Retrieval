# Build files
/build/
cmake-build-*/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Dataset (downloaded separately with scripts/download_dataset.sh)
data/raw/

# Processed data: keep only the small validation reports
data/processed/*
!data/processed/dataset_report.json
!data/processed/exclusion_report.csv

# Embeddings, checkpoints and indexes (regenerated by the pipeline)
*.bin
data/embeddings/*.partial
data/embeddings/*.ckpt.json
data/index/

# Model weights
models/
*.pt
*.pth
*.onnx

# IDE and OS files
.idea/
.vscode/
.DS_Store

# Secrets
.env
.env.*
!.env.example

# Project documents (kept locally, not published)
*.pdf
*.docx
